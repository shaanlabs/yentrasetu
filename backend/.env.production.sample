# Render Production Environment Variables — Backend
# Copy these into Render Dashboard -> Environment tab

NODE_ENV=production
PORT=5000
DATABASE_URL=postgres://... (Auto-provided by Render Postgres)
JWT_SECRET=generate_a_long_random_string_here
FRONTEND_URL=https://yantrasetu.onrender.com (Change to your frontend URL)

# OTP Service (Optional POC - keeps using console if missing)
# SMS_SERVICE_API_KEY=...
